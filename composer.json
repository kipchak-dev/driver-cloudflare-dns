{
    "name": "kipchak/driver-cloudflare-dns",
    "type": "library",
    "description": "A Cloudflare DNS driver for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "Cloudflare",
        "DNS",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\CloudflareDns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kipchak\\Driver\\CloudflareDns\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "kipchak/core": "^2 || ^3",
        "kipchak/driver-config": "^1",
        "kipchak/driver-http": "^1 || ^2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    }
}
