{
    "name": "kipchak/driver-cloudflare-dns",
    "type": "library",
    "description": "A Cloudflare DNS driver for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "Cloudflare",
        "DNS",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\CloudflareDns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kipchak\\Driver\\CloudflareDns\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "kipchak/core": "^2 || ^3",
        "kipchak/driver-config": "^1",
        "kipchak/driver-http": "^1 || ^2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "extra": {
        "kipchak": {
            "type": "driver",
            "config": "sample.config.php",
            "configName": "kipchak.cloudflare-dns.php",
            "initialise": "\\Kipchak\\Driver\\CloudflareDns\\CloudflareDns::initialise($container);",
            "after": [
                "kipchak/driver-config",
                "kipchak/driver-logger",
                "kipchak/driver-http"
            ],
            "before": [],
            "docs": "https://kipchak.dev/docs/driver-cloudflare-dns"
        }
    }
}
